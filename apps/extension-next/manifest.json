{
  "manifest_version": 3,
  "name": "Kibitzer",
  "version": "0.3.0",
  "description": "AI로 브라우징의 목표 이탈을 판정하고, 딴짓이 쌓일 때만 자연스럽게 훈수하는 몰입 도우미. 원하면 AI 없이도 사용할 수 있어요.",
  "minimum_chrome_version": "123",
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "webNavigation",
    "scripting",
    "alarms",
    "storage",
    "idle",
    "downloads",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
