{
  "manifest_version": 3,
  "name": "Kibitzer",
  "version": "0.3.0",
  "description": "목표를 선언하면 브라우징을 조용히 지켜보다, 딴짓이 쌓일 때만 슬쩍 훈수를 두는 로컬 집중 도우미. 서버 없음 — 기본 판정도 기록도 내 브라우저 안에서만.",
  "minimum_chrome_version": "123",
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "webNavigation",
    "scripting",
    "alarms",
    "storage",
    "idle",
    "downloads",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
